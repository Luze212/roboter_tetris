{
  "name": "Board Detection",
  "description": {
    "brief": "Erkennt ein Board aus Markern in einem Farbbild.",
    "details": "Detektiert ArUco-Markierungen und liefert Board-Eckinformationen. Diese Komponente ist auf reine Board-Erkennung ausgelegt, ohne Kamera-zu-Roboter-Transformation."
  },
  "registration": "roboter_tetris::BoardDetection",
  "inherits": "modulo_components::LifecycleComponent",
  "inputs": [
    {
      "display_name": "Color Image",
      "description": "RGB-Farbbild der Kamera.",
      "signal_name": "color_image",
      "signal_type": "other",
      "custom_signal_type": "sensor_msgs::msg::Image"
    },
    {
      "display_name": "Color Camera Info",
      "description": "Optional: Kamera-Intrinsics für spätere Pose-Schätzung. Aktuell wird das Board allein aus dem Bild detektiert.",
      "signal_name": "color_camera_info",
      "signal_type": "other",
      "custom_signal_type": "sensor_msgs::msg::CameraInfo"
    }
  ],
  "outputs": [
    {
      "display_name": "Board-Ecken",
      "description": "Flaches Array [id, x, y] pro erkannter Board-Ecke oder Marker; x/y in Pixeln im Farbbild. Leer, wenn kein Board erkannt wird.",
      "signal_name": "board_corners",
      "signal_type": "double_array"
    },
    {
      "display_name": "Debug Image",
      "description": "Farbbild mit eingezeichneten ArUco-Markern und detektierten Board-Ecken, nur wenn Debug aktiviert.",
      "signal_name": "debug_image",
      "signal_type": "other",
      "custom_signal_type": "sensor_msgs::msg::Image"
    }
  ],
  "predicates": [
    {
      "display_name": "Board erkannt",
      "description": "True, wenn mindestens ein passendes Board im aktuellen Bild erkannt wurde.",
      "predicate_name": "has_board"
    },
    {
      "display_name": "Receiving Frames",
      "description": "True, solange frische Kamera-Frames ankommen (False nach ~1 s ohne neuen Frame).",
      "predicate_name": "is_receiving_frames"
    }
  ],
  "parameters": [
    {
      "display_name": "Board Type",
      "description": "false=CHARUCO | true=GRID/AprilGrid",
      "parameter_name": "board_type",
      "parameter_type": "bool",
      "default_value": "false",
      "dynamic": true
    },
    {
      "display_name": "ArUco/AprilTag Dictionary",
      "description": "Wird automatisch basierend auf Board Type gesetzt.",
      "parameter_name": "aruco_dictionary",
      "parameter_type": "string",
      "default_value": "DICT_5X5_250",
      "internal": true,
      "dynamic": true
    },
    {
      "display_name": "Board Rows",
      "description": "Wird automatisch basierend auf Board Type gesetzt.",
      "parameter_name": "board_rows",
      "parameter_type": "int",
      "default_value": "5",
      "internal": true,
      "dynamic": true
    },
    {
      "display_name": "Board Cols",
      "description": "Wird automatisch basierend auf Board Type gesetzt.",
      "parameter_name": "board_cols",
      "parameter_type": "int",
      "default_value": "7",
      "internal": true,
      "dynamic": true
    },
    {
      "display_name": "Marker Spacing (m)",
      "description": "Für CHARUCO: Abstand zwischen Markerrand und Quadratseite (Checker-Size minus Marker-Size). Für GRID: Abstand zwischen Tag-Kanten.",
      "parameter_name": "marker_spacing_m",
      "parameter_type": "double",
      "default_value": "0.009",
      "internal": true,
      "dynamic": true
    },
    {
      "display_name": "Marker Length (m)",
      "description": "Wird automatisch basierend auf Board Type gesetzt.",
      "parameter_name": "marker_length_m",
      "parameter_type": "double",
      "default_value": "0.026",
      "internal": true,
      "dynamic": true
    },
    {
      "display_name": "Minimale Marker",
      "description": "Minimale Anzahl erkannter Marker für gültige Detektion.",
      "parameter_name": "min_detected_markers",
      "parameter_type": "int",
      "default_value": "4",
      "internal": true,
      "dynamic": true
    },
    {
      "display_name": "Debug aktivieren",
      "description": "Debug-Bild erzeugen und publizieren.",
      "parameter_name": "debug_enable",
      "parameter_type": "bool",
      "default_value": "false",
      "dynamic": true
    }
  ]
}
