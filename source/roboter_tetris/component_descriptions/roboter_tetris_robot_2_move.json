{
  "name": "Robot 2 Move",
  "description": {
    "brief": "Fährt Roboter 2 zu einer manuell eingegebenen kartesischen Zielposition.",
    "details": "Erzeugt eine kartesische Target EE Pose für den Signal Point Attractor. Die Zielwerte werden in Millimetern im Förderband-Frame (conveyor) oder Roboterbasis-Frame (world) eingegeben. Während der Fahrt bleibt die aktuelle Endeffektororientierung erhalten."
  },
  "registration": "roboter_tetris::Robot2Move",
  "inherits": "modulo_components::LifecycleComponent",
  "inputs": [
    {
      "display_name": "Robot EE Pose",
      "description": "Gemessene Endeffektor-Pose im Roboterbasis-/world-Frame.",
      "signal_name": "robot_ee_pose",
      "signal_type": "cartesian_pose"
    }
  ],
  "outputs": [
    {
      "display_name": "Target EE Pose",
      "description": "Mit dem Attractor Pose Eingang des Signal Point Attractors verbinden.",
      "signal_name": "target_ee_pose",
      "signal_type": "cartesian_pose"
    },
    {
      "display_name": "Current Position World (mm)",
      "description": "Aktuelle EE-Position als [X, Y, Z] im world-/Roboterbasis-Frame in mm.",
      "signal_name": "current_position_world_mm",
      "signal_type": "double_array"
    },
    {
      "display_name": "Current Position Conveyor (mm)",
      "description": "Aktuelle EE-Position als [X, Y, Z] im Förderband-Frame in mm; leer ohne geladene Förderband-Kalibrierung.",
      "signal_name": "current_position_conveyor_mm",
      "signal_type": "double_array"
    }
  ],
  "services": [
    {
      "display_name": "Move To Target",
      "description": "Liest die Zielparameter ein und startet die Zieltrajektorie.",
      "service_name": "move_to_target"
    },
    {
      "display_name": "Stop Motion",
      "description": "Hält die aktuelle gemessene EE-Pose als neues Ziel.",
      "service_name": "stop_motion"
    }
  ],
  "predicates": [
    {
      "display_name": "Is Moving",
      "description": "True, während die Zieltrajektorie erzeugt wird.",
      "predicate_name": "is_moving"
    },
    {
      "display_name": "At Target",
      "description": "True, nachdem die erzeugte Zieltrajektorie beendet wurde.",
      "predicate_name": "at_target"
    },
    {
      "display_name": "Has Failed",
      "description": "True nach ungültiger Pose, Kalibrierdatei oder einem abgelehnten Ziel.",
      "predicate_name": "has_failed"
    }
  ],
  "parameters": [
    {
      "display_name": "Target X (mm)",
      "description": "Ziel-X im gewählten Koordinatenframe.",
      "parameter_name": "target_x_mm",
      "parameter_type": "double",
      "default_value": "0.0",
      "dynamic": true
    },
    {
      "display_name": "Target Y (mm)",
      "description": "Ziel-Y im gewählten Koordinatenframe.",
      "parameter_name": "target_y_mm",
      "parameter_type": "double",
      "default_value": "0.0",
      "dynamic": true
    },
    {
      "display_name": "Target Z (mm)",
      "description": "Ziel-Z im gewählten Koordinatenframe.",
      "parameter_name": "target_z_mm",
      "parameter_type": "double",
      "default_value": "200.0",
      "dynamic": true
    },
    {
      "display_name": "Coordinate Frame",
      "description": "conveyor für Förderbandkoordinaten oder world für Roboterbasis-Koordinaten.",
      "parameter_name": "coordinate_frame",
      "parameter_type": "string",
      "default_value": "conveyor",
      "dynamic": true
    },
    {
      "display_name": "Calibration File Path",
      "description": "Kalibrierdatei mit T_robot_conveyor, erforderlich für coordinate_frame=conveyor.",
      "parameter_name": "calibration_file_path",
      "parameter_type": "string",
      "default_value": "/tmp/calibration.json",
      "dynamic": true
    },
    {
      "display_name": "Move Speed (m/s)",
      "description": "Geschwindigkeit der erzeugten Zieltrajektorie.",
      "parameter_name": "move_speed_m_s",
      "parameter_type": "double",
      "default_value": "0.05",
      "dynamic": true
    },
    {
      "display_name": "Max Travel Distance (m)",
      "description": "Sicherheitsgrenze für die Distanz eines Fahrbefehls.",
      "parameter_name": "max_travel_distance_m",
      "parameter_type": "double",
      "default_value": "0.5",
      "dynamic": true
    }
  ]
}
