{"kind":"textbox","id":"sh/tcny5w32","slideIndex":0,"position":{"left":280,"top":410,"width":1060,"height":54},"name":"Poster descriptor","text":"Greifen unterschiedlich großer farbiger Klötze von einem laufenden Förderband mit einem UR10e","geometry":"rect","lineWidth":0,"style":{"fontSize":24.5,"typeface":"Arial","color":"#202A34","alignment":"center"}}
